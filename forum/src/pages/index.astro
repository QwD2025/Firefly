---
import Forum from "../layouts/Forum.astro";
import { boards } from "../data/site";
import { formatTime, getThreads } from "../data/forum";

const threads = await getThreads();
---
<Forum title="论坛首页" active="home">
  <div class="page-heading index-heading">
    <h1>论坛分区</h1>
    <a class="index-archive" href="/archive/">浏览历史档案</a>
  </div>
  <section class="panel" aria-label="论坛分区">
    <table class="forum-table">
      <colgroup><col /><col class="col-count" /><col class="col-count" /><col class="col-last" /></colgroup>
      <thead>
        <tr><th scope="col">分区</th><th scope="col" class="number">主题</th><th scope="col" class="number">回帖</th><th scope="col" class="last-column">最后回帖</th></tr>
      </thead>
      <tbody>
        {boards.map((board) => {
          const topics = threads.filter((thread) => thread.board === board.id);
          const latest = topics[0];
          return (
            <tr>
              <th scope="row">
                <div class="board-name">
                  <span class="board-icon" aria-hidden="true"></span>
                  <a class="row-title" href={`/board/${board.id}/`}>{board.name}</a>
                </div>
              </th>
              <td class="number">{topics.length}</td>
              <td class="number">{topics.reduce((total, topic) => total + topic.posts.length - 1, 0)}</td>
              <td class="last-column last-post">
                {latest ? <a href={`/topic/${latest.id}/#post-${latest.last.data.number}`}>{formatTime(latest.last.data.postedAt)}</a> : <span>暂无</span>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </section>
</Forum>
