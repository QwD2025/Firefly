---
import Forum from "../layouts/Forum.astro";
import { site } from "../data/site";
---
<Forum title="关于本站" active="about">
  <div class="page-heading"><h1>关于本站</h1></div>
  <section class="panel" aria-labelledby="site-information">
    <h2 class="panel-title" id="site-information">站点资料</h2>
    <dl class="site-information">
      <div><dt>站名</dt><dd>{site.name}</dd></div>
      <div><dt>建站年份</dt><dd>{site.foundedYear}</dd></div>
      <div><dt>历年帖子</dt><dd><a href="/archive/">{site.foundedYear}–{site.worldYear} 年档案</a></dd></div>
      <div><dt>访问方式</dt><dd>访客可浏览主题、回帖与历史档案。</dd></div>
    </dl>
  </section>
</Forum>
