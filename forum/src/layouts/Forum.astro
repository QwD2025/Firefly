---
import "../styles/forum.css";
import { site } from "../data/site";

interface Props {
  title: string;
  active?: "home" | "archive" | "about";
  trail?: Array<{ label: string; href: string }>;
  search?: boolean;
}
const { title, active, trail, search = true } = Astro.props;
const nav = [
  { id: "home", title: "论坛首页", href: "/" },
  { id: "archive", title: "历史档案", href: "/archive/" },
  { id: "about", title: "关于本站", href: "/about/" },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${site.name} 社区，自 ${site.foundedYear} 年起聊街坊日常、老街旧事和都市怪谈。`} />
    <meta name="theme-color" content="#21476a" />
    <title>{title} · {site.name}</title>
  </head>
  <body>
    <dialog class="entry-notice" aria-labelledby="entry-title" aria-describedby="entry-copy" data-nosnippet>
      <h2 id="entry-title" class="panel-title">入站提示</h2>
      <p id="entry-copy">本站为虚构论坛，站内人物、帖子和事件均为虚构。</p>
      <form method="dialog"><button autofocus>我知道了，进入论坛</button></form>
    </dialog>
    <script is:inline>
      (() => {
        const notice = document.querySelector(".entry-notice");
        const key = "linelog-entry-acknowledged";
        for (const name of ["localStorage", "sessionStorage"]) {
          try { if (window[name].getItem(key) === "1") return; } catch {}
        }
        function acknowledge() {
          for (const name of ["localStorage", "sessionStorage"]) {
            try { window[name].setItem(key, "1"); break; } catch {}
          }
        }
        notice.addEventListener("submit", acknowledge, { once: true });
        notice.addEventListener("cancel", acknowledge, { once: true });
        notice.showModal();
      })();
    </script>
    <a href="#main" class="skip-link">跳到正文</a>
    <div class="site-shell">
      <header>
        <div class="masthead">
          <a class="brand" href="/" aria-label={`${site.name} 论坛首页`}>
            <span class="brand-mark" aria-hidden="true"></span>
            <span>
              <span class="brand-name">{site.name}</span>
              <span class="brand-meta">创立于 {site.foundedYear} 年</span>
            </span>
          </a>
          <div class="world-date">
            <span>论坛年历</span>
            <strong>{site.worldYear}</strong>
          </div>
        </div>
        <div class="navigation">
          <nav class="main-links" aria-label="主导航">
            {nav.map((entry) => (
              <a href={entry.href} aria-current={active === entry.id ? "page" : undefined}>
                {entry.title}
              </a>
            ))}
          </nav>
          {search && (
            <form class="quick-search" action="/search/">
              <label class="visually-hidden" for="quick-query">搜索主题</label>
              <input name="q" id="quick-query" type="search" placeholder="搜索主题" maxlength="80" required />
              <button>搜索</button>
            </form>
          )}
        </div>
      </header>
      <main id="main">
        {trail && (
          <nav class="breadcrumbs" aria-label="当前位置">
            <ol>
              <li><a href="/">论坛首页</a></li>
              {trail.map((entry) => <li><a href={entry.href}>{entry.label}</a></li>)}
              <li aria-current="page">{title}</li>
            </ol>
          </nav>
        )}
        <slot />
      </main>
      <footer class="site-footer">
        <span>{site.name} <span aria-hidden="true">·</span> {site.foundedYear}–{site.worldYear}</span>
        <a href="/about/">关于本站</a>
      </footer>
    </div>
  </body>
</html>
